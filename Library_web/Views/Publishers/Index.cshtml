@model IEnumerable<Library_web.Models.DTO.publisherDTO>
<div class="container mt-4">
    <h2 class="mb-4">Danh sách nhà xuất bản</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <a asp-controller="Publishers" asp-action="addPublisher" class="btn btn-primary mb-3">Thêm NXB</a>

    <table class="table table-bordered">
        <tr>
            <th>Id</th>
            <th>Tên NXB</th>
            <th>Chi tiết</th>
            <th>Sửa</th>
            <th>Xóa</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td><a asp-controller="Publishers" asp-action="listPublisher" asp-route-id="@item.Id">Chi tiết</a></td>
                <td><a asp-controller="Publishers" asp-action="editPublisher" asp-route-id="@item.Id">Sửa</a></td>
                <td><a asp-controller="Publishers" asp-action="delPublisher" asp-route-id="@item.Id" onclick="return confirm('Xác nhận xóa?')">Xóa</a></td>
            </tr>
        }
    </table>
</div>