@model Library_web.Models.DTO.BookDTO

<div class="container mt-4" style="max-width: 700px;">

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <h2 class="mb-4">Thông tin sách</h2>

    <div class="row">
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(Model.CoverUrl))
            {
                <img src="@Model.CoverUrl" class="img-fluid rounded" style="max-width: 200px;" alt="Cover" />
            }
        </div>
        <div class="col-md-8">
            <h4>@Model.Title</h4>
            <p><strong>Mô tả:</strong> @Model.Description</p>
            <p><strong>Thể loại:</strong> @Model.Genre</p>
            <p><strong>Nhà xuất bản:</strong> @Model.PublisherName</p>
            <p>
                <strong>Tác giả:</strong>
                @if (Model.AuthorNames != null)
                {
                    @foreach (var item in Model.AuthorNames)
                    {
                        @item <br />
                    }
                }
                else
                {
                    <span>Chưa có tác giả</span>
                }
            </p>
            <p><strong>Ngày thêm:</strong> @Model.DateAdded.ToString("dd/MM/yyyy")</p>

            <p>
                <strong>Trạng thái:</strong>
                @if (Model.IsRead)
                {
                    <span class="badge bg-success">Đã đọc</span>
                    <span> - Ngày đọc: @(Model.DateRead?.ToString("dd/MM/yyyy") ?? "N/A")</span>
                }
                else
                {
                    <span class="badge bg-secondary">Chưa đọc</span>
                }
            </p>

            <p>
                <strong>Đánh giá:</strong>
                @if (Model.IsRead && Model.Rate.HasValue)
                {
                    for (var i = 0; i < Model.Rate; i++)
                    {
                        <span class="glyphicon glyphicon-star">★</span>
                    }
                }
                else
                {
                    <span>Chưa đánh giá</span>
                }
            </p>
        </div>
    </div>

    <a asp-controller="Books" asp-action="Index" class="btn btn-secondary mt-3">Quay lại danh sách</a>
    <a asp-controller="Books" asp-action="editBook" asp-route-id="@Model.Id" class="btn btn-primary mt-3">Chỉnh sửa</a>
</div>